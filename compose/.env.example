# Local-dev environment for the compose stack. Copy to `.env`:
#
#     cp compose/.env.example compose/.env
#
# Compose reads `env_file` at PARSE time, so without this file every command
# fails — including `docker compose up -d openbb-mcp firecrawl-mcp searxng`,
# which needs none of these values. Compose v2.13 (what this stack targets) has
# no `required: false`, so the file has to exist even when it is empty.
#
# `*.env` is gitignored. Nothing here should ever be committed.

# --- LLM providers -----------------------------------------------------------
# At least one is required for the agent to run. muffin's llm_chain defaults to
# Ollama Cloud primary + OpenRouter fallback; see muffin-agent/CLAUDE.md.
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Market data -------------------------------------------------------------
# Consumed by openbb-mcp. Free tier is enough for local work.
FMP_API_KEY=

# --- Observability (optional) ------------------------------------------------
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# --- Local-dev conveniences --------------------------------------------------
# Which agent image langgraph-api runs. Build it locally with
# `docker build -t muffin-agent:latest .` in muffin-agent, or point at GHCR.
IMAGE_NAME=muffin-agent:latest

# Collapses anonymous traffic onto one /memories/ namespace so agent-chat-ui
# (which does not populate configurable.user_id) can exercise persistent
# memory. Without it those agents raise MemoryUnavailableError.
# NEVER set this in a multi-user deployment.
MEMORY_DEBUG_USER_ID=test-user-id
